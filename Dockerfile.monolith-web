# 单体部署专用的前端镜像：容器内构建 Vue 前端，打包进 nginx，
# 使用指向单体 app:8080 的网关配置（区别于微服务版的 default.conf）。
FROM node:22-alpine AS frontend-build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/monolith-compose.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
